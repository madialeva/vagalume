<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\..\src\Vagalume.Postgres.Embedded\Vagalume.Postgres.Embedded.csproj" />
    <ProjectReference Include="..\Vagalume.Testing\Vagalume.Testing.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
    <PostgresPlatform Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-amd64</PostgresPlatform>
    <PostgresPlatform Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows-amd64</PostgresPlatform>
  </PropertyGroup>

  <!-- Fetches the pinned PostgreSQL binaries of this platform; skipped while the lock file is unchanged. -->
  <Target Name="FetchPostgresBinaries"
          BeforeTargets="BeforeBuild"
          Inputs="$(RepoRoot)eng/postgres-binaries.lock;$(RepoRoot)eng/fetch-postgres-binaries.cs"
          Outputs="$(RepoRoot)artifacts/postgres/$(PostgresPlatform)/.fetched">
    <Exec Command="dotnet &quot;$(RepoRoot)eng/fetch-postgres-binaries.cs&quot; &quot;$(RepoRoot)eng/postgres-binaries.lock&quot; &quot;$(RepoRoot)artifacts/postgres&quot; $(PostgresPlatform)" />
  </Target>

</Project>
